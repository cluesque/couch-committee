<% title = @list_entry.title %>
<% content_for :title, "Mark #{title.full_name} as watched · Couch Committee" %>

<%= back_link title.full_name, [ @list, @list_entry ] %>
<h1 class="h3 mb-3">Mark <%= title.full_name %> as watched</h1>

<%= turbo_frame_tag "watch" do %>
  <%= form_with model: @viewing, url: list_list_entry_viewings_path(@list, @list_entry),
        data: { turbo_frame: "_top" }, class: "card card-body" do |form| %>
    <% if @viewing.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @viewing.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if title.movie? %>
      <%= form.hidden_field :episode_id %>
    <% else %>
      <div class="mb-3">
        <%= form.label :episode_id, "Episode", class: "form-label" %>
        <%= form.select :episode_id,
              title.episodes.map { |episode| [ "#{episode.label}#{" (watched)" if @list_entry.viewed?(episode)}", episode.id ] },
              {}, class: "form-select" %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :date, "Watched on", class: "form-label" %>
      <%# Today, in the browser's time zone; but a date sent back with an error stays as it was. %>
      <%= form.date_field :date, required: true, class: "form-control",
            data: ({ controller: "local-date" } if @viewing.errors.none?) %>
    </div>

    <div>
      <%= form.submit "Mark watched", class: "btn btn-primary" %>
      <%= link_to "Not now", [ @list, @list_entry ], class: "btn btn-link" %>
    </div>
  <% end %>
<% end %>
