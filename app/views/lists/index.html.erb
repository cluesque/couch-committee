<% content_for :title, "Couch Committee" %>

<h1 class="visually-hidden">Home</h1>

<%= image_tag "/logo_with_name.png",
              alt: "Couch Committee — what should we watch tonight?",
              class: "img-fluid mx-auto d-block mb-4" %>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h2 class="h4 mb-0">Lists</h2>
  <%= link_to "New list", new_list_path, class: "btn btn-primary btn-sm" %>
</div>
<% if @lists.any? && @lists.none? { |list| list.users.many? } %>
  <p class="hint text-end small mb-2">
    <span class="hint-arrow hint-arrow-new" aria-hidden="true">↑</span>
    Watching with someone? Start a list for the two of you.
  </p>
<% end %>

<% if @lists.any? %>
  <div class="list-group">
    <% @lists.each do |list| %>
      <% others = (list.users - [ Current.user ]).map(&:name).sort_by(&:downcase) %>
      <%= link_to list, class: "list-group-item list-group-item-action" do %>
        <div><%= list.name %></div>
        <% if others.any? %>
          <div class="small text-body-secondary">with <%= others.to_sentence %></div>
        <% end %>
        <% unless list.id.in?(@lists_with_entries) %>
          <div class="small text-body-secondary">Empty. Open it to add something you want to watch.</div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-body-secondary">
    You're not on any lists yet. Start one, or ask someone to add
    <strong><%= Current.user.email %></strong> to theirs.
  </p>
<% end %>

<p class="mt-4"><%= link_to "Browse titles", titles_path %></p>
