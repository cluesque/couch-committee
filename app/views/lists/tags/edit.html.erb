<% content_for :title, "Edit #{@tag.name} · Couch Committee" %>

<%= back_link "Edit #{@list.name}", edit_list_path(@list) %>
<h1 class="h3 mb-3">Edit tag</h1>

<%= turbo_frame_tag @tag, class: "d-block" do %>
  <div class="card card-body">
    <%= form_with model: @tag, url: list_tag_path(@list, @tag), data: { turbo_frame: "_top" } do |form| %>
      <% if @tag.errors.any? %>
        <div class="alert alert-danger"><%= @tag.errors.full_messages.to_sentence %></div>
      <% end %>
      <div class="mb-2">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, maxlength: 20, autocomplete: "off", required: true, class: "form-control" %>
      </div>
      <fieldset class="mb-3">
        <legend class="visually-hidden">Color</legend>
        <div class="d-flex flex-wrap gap-1">
          <%= tag_color_choices "tag[color]", selected: @tag.color, id_prefix: "tag_#{@tag.id}_color" %>
        </div>
      </fieldset>
      <div class="d-flex flex-wrap align-items-center gap-2">
        <%= form.submit "Save", class: "btn btn-primary" %>
        <%= link_to "Never mind", edit_list_path(@list), class: "btn btn-link" %>
      </div>
    <% end %>
    <% entries = @tag.list_entries.size %>
    <%= button_to "Delete tag", list_tag_path(@list, @tag), method: :delete,
          class: "btn btn-sm btn-outline-danger", form_class: "mt-3",
          form: { data: { turbo_frame: "_top",
            turbo_confirm: "Delete #{@tag.name}?#{" It comes off #{pluralize(entries, "entry", plural: "entries")}." if entries.positive?}" } } %>
  </div>
<% end %>
