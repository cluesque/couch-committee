<div class="row g-2 align-items-end border-bottom pb-3 mb-3" data-episode-fields-target="row">
  <div class="col-3">
    <%= form.label :number, "No.", class: "form-label small" %>
    <%= form.number_field :number, min: 1, required: true, class: "form-control",
          data: { episode_fields_target: "number" } %>
  </div>
  <div class="col-9">
    <%= form.label :name, "Episode name", class: "form-label small" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="col">
    <%= form.label :available_on, "Available on", class: "form-label small" %>
    <%= form.date_field :available_on, class: "form-control" %>
  </div>
  <div class="col-auto">
    <button type="button" class="btn btn-outline-danger" data-action="episode-fields#remove"
            aria-label="Remove episode">&times;</button>
  </div>
</div>
