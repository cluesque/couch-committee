<% content_for :title, "Titles · Couch Committee" %>

<%= back_link "Home", root_path %>

<h1 class="h3 mb-1">Titles</h1>
<p class="text-body-secondary small mb-3">Everything anyone has added to a list, from TMDB.</p>

<% if @titles.any? %>
  <div class="list-group mb-3">
    <% @titles.each do |title| %>
      <%= link_to title, class: "list-group-item list-group-item-action d-flex align-items-baseline gap-2" do %>
        <%= kind_icon(title) %>
        <span class="title-name"><%= title.full_name %></span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-body-secondary">No titles yet. They arrive here when someone adds one to a list.</p>
<% end %>

