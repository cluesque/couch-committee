<%# A title's poster, name, facts, links, and overview, atop its page and its list entries' pages. %>
<div class="d-flex gap-3 align-items-start mb-3">
  <% if title.poster_path.present? %>
    <%= image_tag Tmdb.image_url(title.poster_path, "w342"), alt: "", width: 100, height: 150,
          class: "title-poster rounded flex-shrink-0 shadow-sm" %>
  <% end %>
  <div class="min-w-0">
    <h1 class="h3 mb-1"><%= title.full_name %></h1>
    <p class="small text-body-secondary mb-1">
      <%= kind_icon(title, decorative: true) %> <%= title_facts(title) %>
    </p>
    <% if title.genres.present? %>
      <p class="small text-body-secondary mb-1"><%= title.genres %></p>
    <% end %>
    <% if title.cast_names.present? %>
      <p class="small text-body-secondary mb-1 title-cast">Starring <%= title.cast_names %></p>
    <% end %>
    <p class="small mb-0 d-flex flex-wrap align-items-center column-gap-3">
      <% if title.imdb_url %><%= link_to "IMDb", title.imdb_url, target: "_blank", rel: "noopener" %><% end %>
      <% if title.tmdb_url %>
        <%= link_to "TMDB", title.tmdb_url, target: "_blank", rel: "noopener" %>
      <% end %>
      <% if title.persisted? && title.tmdb_url %>
        <%= button_to "Refresh", title_refresh_path(title), params: { return_to: request.path },
              class: "btn btn-link btn-sm p-0 border-0 align-baseline", form_class: "d-inline",
              title: ("Last updated from TMDB #{l title.tmdb_synced_at.to_date, format: :short}" if title.tmdb_synced_at) %>
      <% elsif title.persisted? %>
        <%= link_to "Find on TMDB", new_title_tmdb_link_path(title, return_to: request.path) %>
      <% end %>
    </p>
  </div>
</div>

<% if title.overview.present? %>
  <p class="title-overview"><%= title.overview %></p>
<% end %>
