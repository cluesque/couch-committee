<% title = @entry.title %>
<% content_for :title, "#{title.full_name} · Couch Committee" %>

<%= back_link @list.name, [ Current.group, @list ] %>

<%= render "titles/header", title: title %>

<p class="text-body-secondary d-flex flex-wrap align-items-center gap-2">
  <span>
    <%= @entry.state.humanize %>
    <% if @entry.last_viewed_on %>
      · Last watched <%= l @entry.last_viewed_on, format: :short %>
    <% end %>
  </span>
  <% if @entry.upcoming? %>
    <span class="badge text-bg-warning text-nowrap">Coming <%= l @entry.next_episode.available_on, format: :short %></span>
  <% end %>
</p>

<%= render "recommendation", entry: @entry %>

<% if @entry.cancelled? %>
  <div class="alert alert-secondary">
    Cancelled <%= l @entry.cancelled_at.to_date, format: :long %><% if @entry.cancel_note %>: “<%= @entry.cancel_note %>”<% end %>
  </div>
<% end %>

<% if @entry.active? %>
  <%= turbo_frame_tag "watch", class: "d-block mb-3" do %>
    <%= link_to "Watch", new_group_list_list_entry_viewing_path(Current.group, @list, @entry),
          class: "btn btn-primary" %>
  <% end %>
<% elsif @active_entry %>
  <p>It's back on <%= @list.name %>: <%= link_to "see where it's up to", [ Current.group, @list, @active_entry ] %>.</p>
<% else %>
  <%= button_to "Watch again", group_list_list_entries_path(Current.group, @list),
        params: { title_id: title.id }, form_class: "mb-3", class: "btn btn-primary" %>
<% end %>

<%= render "titles/where_to_watch", title: title %>

<%= render "titles/episodes", title: title, entry: @entry %>

<% if @entry.active? %>
  <%= turbo_frame_tag "cancellation", class: "d-block mt-4" do %>
    <%= link_to "Cancel…", new_group_list_list_entry_cancellation_path(Current.group, @list, @entry),
          class: "btn btn-outline-danger btn-sm" %>
  <% end %>
<% end %>
