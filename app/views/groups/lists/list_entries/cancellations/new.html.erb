<% title = @list_entry.title %>
<% content_for :title, "Cancel #{title.full_name} · Couch Committee" %>

<%= back_link title.full_name, [ Current.group, @list, @list_entry ] %>
<h1 class="h3 mb-3">Cancel <%= title.full_name %>?</h1>

<%= turbo_frame_tag "cancellation" do %>
  <%= form_with scope: :cancellation,
        url: group_list_list_entry_cancellation_path(Current.group, @list, @list_entry),
        data: { turbo_frame: "_top" }, class: "card card-body" do |form| %>
    <p class="mb-2">
      It comes off <%= @list.name %> and moves to the list's history, along with your note.
    </p>
    <div class="mb-3">
      <%= form.label :note, "Why? (optional)", class: "form-label" %>
      <%= form.text_area :note, rows: 2, class: "form-control" %>
    </div>
    <div>
      <%= form.submit "Cancel it", class: "btn btn-danger" %>
      <%= link_to "Keep it", [ Current.group, @list, @list_entry ], class: "btn btn-link" %>
    </div>
  <% end %>
<% end %>
