<% content_for :title, "Add to #{@list.name} · Couch Committee" %>

<%= back_link @list.name, [ Current.group, @list ] %>

<h1 class="h3 mb-3">Add to <%= @list.name %></h1>

<%= form_with url: new_group_list_list_entry_path(Current.group, @list), method: :get, class: "mb-3" do |form| %>
  <%= form.label :q, "Search movies and shows", class: "visually-hidden" %>
  <div class="input-group">
    <%= form.search_field :q, value: @query, autofocus: true, placeholder: "Search movies and shows",
          class: "form-control" %>
    <%= form.submit "Search", name: nil, class: "btn btn-primary" %>
  </div>
<% end %>

<% if @query.present? %>
  <% if @results.any? || @hand_entered_titles&.any? %>
    <%= render "add_title_form", hidden: { q: @query } %>
  <% end %>

  <% if @results.any? %>
    <ul class="list-group mb-3">
      <% @results.each do |result| %>
        <% only_season = @only_seasons[result.tmdb_id] if result.kind == "series" %>
        <%# Tapping the poster or name opens a preview; a show with several seasons opens its seasons. %>
        <% details = if result.kind == "movie"
             { name: "tmdb_movie_id", formaction: preview_group_list_list_entries_path(Current.group, @list) }
           elsif only_season
             { name: "tmdb_show_id", formaction: preview_group_list_list_entries_path(Current.group, @list, season: only_season) }
           else
             { name: "tmdb_show_id", formaction: seasons_group_list_list_entries_path(Current.group, @list) }
           end %>
        <li class="list-group-item d-flex align-items-center gap-2">
          <%= button_tag form: "add_title", value: result.tmdb_id, **details, "aria-label": "#{result.name} details",
                class: "result-details btn p-0 border-0 text-start text-reset d-flex align-items-center gap-2 flex-grow-1 min-w-0" do %>
            <%= poster_thumb(result.poster_path) %>
            <span class="flex-grow-1 min-w-0">
              <span class="d-flex align-items-baseline gap-2">
                <%= kind_icon(result) %>
                <span class="title-name"><%= result.name %></span>
              </span>
              <% if result.year %>
                <span class="small text-body-secondary ps-4"><%= result.year %></span>
              <% end %>
            </span>
          <% end %>

          <% if only_season && @active_title_ids.include?(@seasons_in_catalog[[ result.tmdb_id, only_season ]]&.id) %>
            <span class="small text-body-secondary text-nowrap">On this list</span>
          <% elsif only_season %>
            <%= button_tag "Add", form: "add_title", name: "tmdb_show_id", value: result.tmdb_id,
                  formaction: group_list_list_entries_path(Current.group, @list, season: only_season),
                  class: "btn btn-sm btn-outline-primary", "aria-label": "Add #{result.name}" %>
          <% elsif result.kind == "series" %>
            <%= button_tag "Seasons ›", form: "add_title", name: "tmdb_show_id", value: result.tmdb_id,
                  formaction: seasons_group_list_list_entries_path(Current.group, @list),
                  class: "btn btn-sm btn-outline-primary text-nowrap", "aria-label": "Seasons of #{result.name}" %>
          <% elsif @active_title_ids.include?(@movies_in_catalog[result.tmdb_id]&.id) %>
            <span class="small text-body-secondary text-nowrap">On this list</span>
          <% else %>
            <%= button_tag "Add", form: "add_title", name: "tmdb_movie_id", value: result.tmdb_id,
                  class: "btn btn-sm btn-outline-primary", "aria-label": "Add #{result.name}" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% elsif !@tmdb_unavailable %>
    <p class="text-body-secondary">No movies or shows match “<%= @query %>”.</p>
  <% end %>

  <% if @hand_entered_titles&.any? %>
    <h2 class="h6 text-body-secondary mt-4">Entered by hand</h2>
    <ul class="list-group mb-3">
      <% @hand_entered_titles.each do |title| %>
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
          <span class="d-flex align-items-baseline gap-2">
            <%= kind_icon(title) %>
            <span class="title-name"><%= title.full_name %></span>
          </span>
          <% if @active_title_ids.include?(title.id) %>
            <span class="small text-body-secondary text-nowrap">On this list</span>
          <% else %>
            <%= button_tag "Add", form: "add_title", name: "title_id", value: title.id,
                  class: "btn btn-sm btn-outline-primary", "aria-label": "Add #{title.full_name}" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
