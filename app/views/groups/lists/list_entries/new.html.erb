<% content_for :title, "Add to #{@list.name} · Couch Committee" %>

<%= back_link @list.name, [ Current.group, @list ] %>

<h1 class="h3 mb-3">Add to <%= @list.name %></h1>

<%= form_with url: new_group_list_list_entry_path(Current.group, @list), method: :get, class: "mb-3" do |form| %>
  <%= form.label :q, "Search titles", class: "visually-hidden" %>
  <div class="input-group">
    <%= form.search_field :q, value: @query, autofocus: true, placeholder: "Search titles", class: "form-control" %>
    <%= form.submit "Search", name: nil, class: "btn btn-primary" %>
  </div>
<% end %>

<% if @query.present? %>
  <% if @titles.any? %>
    <ul class="list-group mb-3">
      <% @titles.each do |title| %>
        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
          <span>
            <%= title.full_name %>
            <span class="badge text-bg-light"><%= title.kind.humanize %></span>
          </span>
          <% if @active_title_ids.include?(title.id) %>
            <span class="small text-body-secondary text-nowrap">On this list</span>
          <% else %>
            <%= button_to "Add", group_list_list_entries_path(Current.group, @list),
                  params: { title_id: title.id, q: @query },
                  class: "btn btn-sm btn-outline-primary", "aria-label": "Add #{title.full_name}" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-body-secondary">No titles match “<%= @query %>”.</p>
  <% end %>
<% end %>

<p class="small text-body-secondary">
  Can't find it? Add a <%= link_to "movie", new_title_path %> or a
  <%= link_to "season", new_title_path(kind: "series") %> to the catalog first.
</p>

