<% content_for :title, "#{@list.name} history · Couch Committee" %>

<%= back_link @list.name, [ Current.group, @list ] %>
<h1 class="h3 mb-3">History</h1>

<% if @events.any? %>
  <ol class="list-group mb-3">
    <% @events.each do |event| %>
      <% viewing = event if event.is_a?(Viewing) %>
      <% entry = viewing ? viewing.list_entry : event %>
      <li class="list-group-item d-flex align-items-start gap-2">
        <%= link_to group_list_list_entry_path(Current.group, @list, entry),
              class: "text-reset text-decoration-none d-flex gap-2 align-items-start flex-grow-1 min-w-0" do %>
          <%= poster_thumb(entry.title.poster_path) %>
          <div class="flex-grow-1 min-w-0">
          <span class="d-flex align-items-baseline gap-2">
            <%= kind_icon(entry.title) %>
            <span class="fw-medium"><%= entry.title.full_name %></span>
          </span>
          <% if viewing %>
            <% unless entry.title.movie? %>
              <div class="small text-body-secondary ps-4"><%= viewing.episode.label %></div>
            <% end %>
          <% else %>
            <div class="small text-body-secondary ps-4">
              <span class="badge text-bg-secondary">Cancelled</span>
              <% if entry.cancel_note %><em><%= entry.cancel_note %></em><% end %>
            </div>
          <% end %>
          </div>
        <% end %>
        <div class="d-flex flex-column align-items-end justify-content-between align-self-stretch flex-shrink-0">
          <small class="text-body-secondary text-nowrap">
            <%= l viewing ? viewing.date : entry.cancelled_at.to_date, format: :short %>
          </small>
        <% if viewing %>
          <% watch = [ entry.title.full_name, (viewing.episode.label unless entry.title.movie?) ].compact.join(" · ") %>
          <% watch += " (#{l viewing.date, format: :short})" %>
          <% others = @other_lists.fetch([ viewing.episode_id, viewing.date ], []) %>
          <% confirm = [ "Unwatch #{watch}?",
               ("It's also recorded on #{others.map(&:name).sort.to_sentence}, and will be removed there too." if others.any?) ].compact.join(" ") %>
          <%= button_to "Unwatch", group_list_list_entry_viewing_path(Current.group, @list, entry, viewing), method: :delete,
                class: "btn btn-link btn-sm p-0 border-0 text-danger", form_class: "d-block",
                form: { data: { turbo_confirm: confirm } }, "aria-label": "Unwatch #{watch}" %>
        <% end %>
        </div>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="text-body-secondary">Nothing watched or cancelled yet.</p>
<% end %>
