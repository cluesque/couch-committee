<% upcoming = list_entry.upcoming? %>
<li class="list-group-item d-flex align-items-start gap-2 <%= "text-body-secondary" if upcoming %>"
    id="<%= dom_id(list_entry) %>" data-sortable-id="<%= list_entry.id %>">
  <span class="text-body-tertiary fs-5 lh-1 pt-1 px-1" style="cursor: grab; touch-action: none"
        data-sortable-handle title="Drag to reorder" aria-hidden="true">⠿</span>

  <%= link_to group_list_list_entry_path(Current.group, list_entry.list_id, list_entry),
        class: "flex-grow-1 min-w-0 text-reset text-decoration-none d-flex gap-2 align-items-start" do %>
    <%= poster_thumb(list_entry.title.poster_path) %>
    <div class="flex-grow-1 min-w-0">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <span class="d-flex align-items-baseline gap-2">
        <%= kind_icon(list_entry.title) %>
        <span class="fw-medium"><%= list_entry.title.full_name %></span>
      </span>
      <% if upcoming %>
        <span class="badge text-bg-warning text-nowrap">
          Coming <%= l list_entry.next_episode.available_on, format: :short %>
        </span>
      <% end %>
    </div>

    <%# How long whatever's next runs: a season's next episode, or the movie itself. %>
    <% length = runtime(list_entry.next_episode&.runtime_minutes) %>
    <% next_episode = list_entry.next_episode unless list_entry.title.movie? %>
    <% if next_episode || length || list_entry.last_viewed_on %>
      <div class="small text-body-secondary d-flex flex-wrap column-gap-3 ps-4">
        <% if next_episode %>
          <span class="next-episode">Next: <%= next_episode.label %><%= " · #{length}" if length %></span>
        <% elsif length %>
          <span class="runtime"><%= length %></span>
        <% end %>
        <% if list_entry.last_viewed_on %>
          <span>Last watched <%= l list_entry.last_viewed_on, format: :short %></span>
        <% end %>
      </div>
    <% end %>
    <% if list_entry.recommendation %>
      <div class="small fst-italic ps-4 recommendation">“<%= list_entry.recommendation %>”</div>
    <% end %>
    </div>
  <% end %>
</li>
