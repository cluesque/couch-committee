<% content_for :title, "New group · Couch Committee" %>

<%= back_link "Your groups", groups_path %>

<h1 class="h3 mb-3">New group</h1>

<%= form_with model: @group do |form| %>
  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, required: true, autofocus: true, placeholder: "e.g. The Smith household",
          class: [ "form-control", { "is-invalid": @group.errors.include?(:name) } ] %>
    <% @group.errors.full_messages_for(:name).each do |message| %>
      <div class="invalid-feedback"><%= message %></div>
    <% end %>
  </div>

  <%= form.submit "Create group", class: "btn btn-primary" %>
  <%= link_to "Cancel", groups_path, class: "btn btn-link" %>
<% end %>
