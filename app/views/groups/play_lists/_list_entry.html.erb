<% upcoming = list_entry.upcoming? %>
<li class="list-group-item d-flex align-items-start gap-2 <%= "bg-body-tertiary text-body-secondary" if upcoming %>"
    id="<%= dom_id(list_entry) %>" data-sortable-id="<%= list_entry.id %>">
  <span class="text-body-tertiary fs-5 lh-1 pt-1 px-1" style="cursor: grab; touch-action: none"
        data-sortable-handle title="Drag to reorder" aria-hidden="true">⠿</span>

  <%= link_to group_play_list_list_entry_path(Current.group, list_entry.play_list_id, list_entry),
        class: "flex-grow-1 text-reset text-decoration-none" do %>
    <div class="d-flex justify-content-between align-items-start gap-2">
      <span class="fw-medium"><%= list_entry.title.full_name %></span>
      <% if upcoming %>
        <span class="badge text-bg-warning text-nowrap">
          Coming <%= l list_entry.next_episode.available_on, format: :short %>
        </span>
      <% end %>
    </div>

    <% next_episode = list_entry.next_episode unless list_entry.title.movie? %>
    <% if next_episode || list_entry.last_viewed_on %>
      <div class="small text-body-secondary d-flex flex-wrap column-gap-3">
        <% if next_episode %>
          <span>Next: <%= next_episode.label %></span>
        <% end %>
        <% if list_entry.last_viewed_on %>
          <span>Last watched <%= l list_entry.last_viewed_on, format: :short %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</li>
