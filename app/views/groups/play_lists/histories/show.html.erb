<% content_for :title, "#{@play_list.name} history · Couch Committee" %>

<p class="small mb-1"><%= link_to "← #{@play_list.name}", [ Current.group, @play_list ] %></p>
<h1 class="h3 mb-3">History</h1>

<% if @events.any? %>
  <ol class="list-group mb-3">
    <% @events.each do |event| %>
      <% viewing = event if event.is_a?(Viewing) %>
      <% entry = viewing ? viewing.list_entry : event %>
      <li class="list-group-item">
        <%= link_to group_play_list_list_entry_path(Current.group, @play_list, entry),
              class: "d-block text-reset text-decoration-none" do %>
          <div class="d-flex justify-content-between align-items-start gap-2">
            <span class="fw-medium"><%= entry.title.full_name %></span>
            <small class="text-body-secondary text-nowrap">
              <%= l viewing ? viewing.date : entry.cancelled_at.to_date, format: :short %>
            </small>
          </div>
          <% if viewing %>
            <% unless entry.title.movie? %>
              <div class="small text-body-secondary"><%= viewing.episode.label %></div>
            <% end %>
          <% else %>
            <div class="small text-body-secondary">
              <span class="badge text-bg-secondary">Cancelled</span>
              <% if entry.cancel_note %><em><%= entry.cancel_note %></em><% end %>
            </div>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="text-body-secondary">Nothing watched or cancelled yet.</p>
<% end %>
