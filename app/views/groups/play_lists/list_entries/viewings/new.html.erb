<% title = @list_entry.title %>
<% content_for :title, "Watch #{title.full_name} · Couch Committee" %>

<p class="small mb-1"><%= link_to "← #{title.full_name}", [ Current.group, @play_list, @list_entry ] %></p>
<h1 class="h3 mb-3">Watch <%= title.full_name %></h1>

<%= turbo_frame_tag "watch" do %>
  <%= form_with model: @viewing, url: group_play_list_list_entry_viewings_path(Current.group, @play_list, @list_entry),
        data: { turbo_frame: "_top" }, class: "card card-body" do |form| %>
    <% if @viewing.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @viewing.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if title.movie? %>
      <%= form.hidden_field :episode_id %>
    <% else %>
      <div class="mb-3">
        <%= form.label :episode_id, "Episode", class: "form-label" %>
        <%= form.select :episode_id,
              title.episodes.map { |episode| [ "#{episode.label}#{" (watched)" if @list_entry.viewed?(episode)}", episode.id ] },
              {}, class: "form-select" %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :date, "Watched on", class: "form-label" %>
      <%= form.date_field :date, required: true, class: "form-control" %>
    </div>

    <div>
      <%= form.submit "Record watch", class: "btn btn-primary" %>
      <%= link_to "Cancel", [ Current.group, @play_list, @list_entry ], class: "btn btn-link" %>
    </div>
  <% end %>
<% end %>
