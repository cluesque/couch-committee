<% title = @entry.title %>
<% content_for :title, "#{title.full_name} · Couch Committee" %>

<p class="small mb-1"><%= link_to "← #{@play_list.name}", [ Current.group, @play_list ] %></p>

<div class="d-flex justify-content-between align-items-start gap-2 mb-1">
  <h1 class="h3 mb-0"><%= title.full_name %></h1>
  <% if @entry.upcoming? %>
    <span class="badge text-bg-warning text-nowrap">Coming <%= l @entry.next_episode.available_on, format: :short %></span>
  <% end %>
</div>
<p class="text-body-secondary">
  <%= title.kind.humanize %> · <%= @entry.state.humanize %>
  <% if @entry.last_viewed_on %>
    · Last watched <%= l @entry.last_viewed_on, format: :short %>
  <% end %>
</p>

<% if @entry.cancelled? %>
  <div class="alert alert-secondary">
    Cancelled <%= l @entry.cancelled_at.to_date, format: :long %><% if @entry.cancel_note %>: “<%= @entry.cancel_note %>”<% end %>
  </div>
<% end %>

<% if @entry.active? %>
  <%= turbo_frame_tag "watch", class: "d-block mb-3" do %>
    <%= link_to "Watch", new_group_play_list_list_entry_viewing_path(Current.group, @play_list, @entry),
          class: "btn btn-primary" %>
  <% end %>
<% end %>

<% if title.movie? %>
  <% if (released_on = title.episodes.first&.available_on) %>
    <p>Released <%= l released_on, format: :long %></p>
  <% end %>
<% else %>
  <h2 class="h5">Episodes</h2>
  <ol class="list-group mb-3">
    <% next_episode = @entry.next_episode %>
    <% title.episodes.each do |episode| %>
      <li class="list-group-item d-flex justify-content-between align-items-start gap-2 <%= "fw-semibold" if episode == next_episode %>">
        <span class="me-auto">
          <% if @entry.viewed?(episode) %>
            <span class="text-success" title="Watched">✓</span>
            <span class="visually-hidden">Watched:</span>
          <% end %>
          <%= episode.label %>
        </span>
        <% if episode.available_on %>
          <small class="text-body-secondary text-nowrap"><%= l episode.available_on, format: :short %></small>
        <% end %>
      </li>
    <% end %>
  </ol>
<% end %>

<% if @entry.active? %>
  <%= turbo_frame_tag "cancellation", class: "d-block mt-4" do %>
    <%= link_to "Cancel…", new_group_play_list_list_entry_cancellation_path(Current.group, @play_list, @entry),
          class: "btn btn-outline-danger btn-sm" %>
  <% end %>
<% end %>
